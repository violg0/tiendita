    int? id,
    int? idProducto,
    int? priority,
    String? texto,
    bool? pendingSync,
    DateTime? updatedAt,
  }) => NotaOffline(
    id: id ?? this.id,
    idProducto: idProducto ?? this.idProducto,
    priority: priority ?? this.priority,
    texto: texto ?? this.texto,
    pendingSync: pendingSync ?? this.pendingSync,
    updatedAt: updatedAt ?? this.updatedAt,
  );
